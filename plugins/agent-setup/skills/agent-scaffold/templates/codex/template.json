{
  "name": "codex",
  "title": "Codex",
  "verified": "2026-11-14",
  "files": [
    {
      "path": ".codex/config.toml",
      "from": "config.toml",
      "description": "프로젝트 설정 — 신뢰한 프로젝트에서만 읽힌다",
      "doc": "https://learn.chatgpt.com/docs/config-file/config-basic.md"
    },
    {
      "path": ".agents/skills/.gitkeep",
      "description": "프로젝트 스킬 폴더",
      "doc": "https://learn.chatgpt.com/docs/build-skills.md"
    }
  ],
  "gitignore": [
    "# Codex 스킬 본체 — 외부에서 받은 것은 잠금 파일로 복원한다",
    "# 직접 만든 스킬은 `!.agents/skills/<이름>/` 처럼 ! 로 제외해 함께 커밋한다",
    ".agents/skills/*",
    "!.agents/skills/.gitkeep"
  ]
